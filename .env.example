# AdOps MCP — Environment Variables
# All integrations are optional. The server works without any API keys
# using local storage for campaign management and analytics.

# ─── Pro License (optional) ──────────────────────────────────────────
# Unlocks Pro features. Buy: https://automatiabcn.lemonsqueezy.com/buy/1525c929-832c-4472-a88a-58edbfa4e87b
# Without a key the server runs in Free tier. Validation is cached locally for 24h.
LEMONSQUEEZY_LICENSE_KEY=

# ─── Server (optional) ───────────────────────────────────────────────
# Set PORT (or MCPIZE) to run as an HTTP server instead of stdio.
# PORT=8080

# ─── Google Ads API — v1.4 roadmap (BYOK) — not yet read by the server ─
# These vars are reserved for a future live-sync integration. The current
# release ingests data via CSV import, so leaving them blank changes nothing.
# Get credentials: https://developers.google.com/google-ads/api/docs/first-call/overview
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# ─── Meta Marketing API — v1.4 roadmap (BYOK) — not yet read by the server ─
# Reserved for a future live-sync integration (see note above).
# Get credentials: https://developers.facebook.com/docs/marketing-apis/
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
